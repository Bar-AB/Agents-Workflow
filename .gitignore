# Claude context / session files. CLAUDE.md itself is tracked: it outgrew
# "session file" and is now the project's design spec — the rationale behind
# every decision rule lives there and nowhere else.
.claude/*
# ...but keep project skills under version control
!.claude/skills/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Frontend (Phase 2). `dist/` above already covers web/dist.
node_modules/

# Agent task workspaces — scratch space for worker output, never source
.agentloop/

# cc10x orchestration state (agent-maintained: activeContext/patterns/progress,
# workflow JSON + event logs). Churns every workflow; not source.
.cc10x/

# Personal working notes: delivery reports, goal prompts, scratch specs.
# Never part of the project that runs, never committed.
temp/
docs/*
# CLAUDE.md (tracked) points into docs/GUIDE.md, docs/CODE_NOTES.md,
# docs/history/ and docs/plans/ for detail it doesn't carry inline — those
# ship too, or CLAUDE.md's own pointers are dead links for anyone who clones
# the repo fresh, and an agent working from that clone loses the reasoning
# behind every function whose behavior looks simpler than it is.
!docs/GUIDE.md
!docs/CODE_NOTES.md
!docs/history/
!docs/plans/

# Loop state & local config (not source)
*.db
*.db-wal
*.db-shm
loopconfig.json
agents.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
