# Claude context / session files. CLAUDE.md itself is tracked: it outgrew
# "session file" and is now the project's design spec — the rationale behind
# every decision rule lives there and nowhere else.
.claude/*
# ...but keep project skills under version control
!.claude/skills/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Frontend (Phase 2). `dist/` above already covers web/dist.
node_modules/

# Agent task workspaces — scratch space for worker output, never source
.agentloop/

# cc10x orchestration state (agent-maintained: activeContext/patterns/progress,
# workflow JSON + event logs). Churns every workflow; not source.
.cc10x/

# Developer-facing working notes: delivery reports, goal prompts, design specs.
# Process artifacts for whoever is driving the build, not part of the project
# that runs. README.md is the product documentation.
temp/
docs/

# Loop state & local config (not source)
*.db
*.db-wal
*.db-shm
loopconfig.json
agents.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
